# saturnBMO - variáveis de ambiente do backend (local, não versionado)
# Gerado a partir de .env.example. Ajuste os valores para o seu ambiente.
# Valores em branco usam o padrão de backend/config.json.

# Configuração do servidor
BMO_HOST=0.0.0.0
BMO_LOG_LEVEL=INFO
BMO_CONFIG=config.json

# LLM (Ollama) - modelo prioriza config.json (llm.model)
BMO_OLLAMA_URL=http://127.0.0.1:11434
BMO_LLM_MODEL=qwen3:8b

# Localização / clima (Open-Meteo) - prioriza config.json (weather.latitude/longitude)
BMO_WEATHER_LOCATION=
BMO_WEATHER_LATITUDE=
BMO_WEATHER_LONGITUDE=
BMO_WEATHER_TIMEZONE=auto

# System prompt - prioriza config.json (llm.system_prompt)
BMO_SYSTEM_PROMPT=

# Wakeword - prioriza config.json (wakeword.phrases)
BMO_WAKEWORD=

# STT (Faster-Whisper no PC). Deixe o modelo em branco para usar config.json (stt.model).
# BMO_STT_BINARY/...MODEL abaixo são apenas do fallback opcional whisper.cpp.
BMO_STT_BINARY=../tools/whisper.cpp/build/bin/whisper-cli
BMO_STT_MODEL=
BMO_STT_LANGUAGE=pt

# TTS (Piper / espeak-ng)
BMO_PIPER_BINARY=../tools/piper/piper
BMO_TTS_VOICE=../tools/voices/pt_BR-faber-medium.onnx
BMO_ESPEAK_VOICE=pt-br

# >>> bmo setupbackend
# Valores gerenciados por scripts/setupbackend.sh
BMO_PORT=8765
BMO_MUSIC_ENABLED=true
BMO_MOPIDY_RPC_URL=http://127.0.0.1:6680/mopidy/rpc
BMO_MOPIDY_PORT=6680
BMO_YTMUSIC_ENABLED=true
BMO_YTMUSIC_LANGUAGE=pt
BMO_YTMUSIC_LOCATION=BR
BMO_MUSIC_STREAM_BASE_URL=http://127.0.0.1:8765
# <<< bmo setupbackend
