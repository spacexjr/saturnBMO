# saturnBMO - variáveis de ambiente do backend (local, não versionado)
# Copie este arquivo para .env e ajuste os valores para o seu ambiente.
# Variáveis deixadas em branco ou ausentes usam o valor de backend/config.json.

# Configuração do servidor
BMO_HOST=0.0.0.0
BMO_PORT=8765
BMO_LOG_LEVEL=INFO
BMO_CONFIG=config.json

# LLM (Ollama) - modelo prioriza config.json (llm.model)
BMO_OLLAMA_URL=http://127.0.0.1:11434
BMO_LLM_MODEL=

# Localização / clima (Open-Meteo) - prioriza config.json (weather.latitude/longitude)
BMO_WEATHER_LOCATION=
BMO_WEATHER_LATITUDE=
BMO_WEATHER_LONGITUDE=
BMO_WEATHER_TIMEZONE=auto

# System prompt - prioriza config.json (llm.system_prompt)
BMO_SYSTEM_PROMPT=

# Wakeword - prioriza config.json (wakeword.phrases)
BMO_WAKEWORD=

# ASR principal: Qwen3-ASR local no Ollama.
# Requer: ollama pull frozenlab/qwen3-asr:0.6b
# Deixe em branco para usar backend/config.json (stt.*).
BMO_ASR_ENGINE=qwen3_asr
BMO_ASR_MODEL=frozenlab/qwen3-asr:0.6b
BMO_ASR_BASE_URL=http://127.0.0.1:11434
BMO_ASR_LANGUAGE=pt-BR
BMO_ASR_TIMEOUT=60
BMO_ASR_MAX_AUDIO_S=55
BMO_ASR_KEEP_ALIVE=10m
# Fallback opcional (Faster-Whisper/whisper.cpp), desligado por padrão.
BMO_ASR_FALLBACK=false
BMO_ASR_FALLBACK_ENGINE=faster_whisper
BMO_ASR_FALLBACK_MODEL=small
# Aliases antigos ainda aceitos: BMO_STT_ENGINE, BMO_STT_MODEL, BMO_STT_LANGUAGE.
BMO_STT_BINARY=../tools/whisper.cpp/build/bin/whisper-cli

# TTS (Piper / espeak-ng)
BMO_PIPER_BINARY=../tools/piper/piper
BMO_TTS_VOICE=../tools/voices/pt_BR-faber-medium.onnx
BMO_ESPEAK_VOICE=pt-br

# Música: Mopidy + YouTube Music
BMO_MUSIC_ENABLED=true
BMO_MOPIDY_RPC_URL=http://127.0.0.1:6680/mopidy/rpc
BMO_YTMUSIC_ENABLED=true
# Arquivo criado por `ytmusicapi browser`; NUNCA versione este arquivo.
BMO_YTMUSIC_AUTH_FILE=data/ytmusic_auth.json
# Opcional: cookies Netscape para faixas restritas do yt-dlp. NUNCA versione.
BMO_YTMUSIC_COOKIES_FILE=
BMO_YTMUSIC_LANGUAGE=pt
BMO_YTMUSIC_LOCATION=BR
# Vazio = http://127.0.0.1:<porta do backend>
BMO_MUSIC_STREAM_BASE_URL=
